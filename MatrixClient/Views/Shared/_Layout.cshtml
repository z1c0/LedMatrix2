@inject MatrixClient.Services.PicoStatus PicoStatus
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - MatrixClient</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/MatrixClient.styles.css" asp-append-version="true" />
</head>
<body>

	<div class="container">
		@{
			var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
		}
		<nav class="px-nav">
			<a asp-controller="Home"     asp-action="Index" class="px-nav-link @(currentController == "Home"     ? "active" : "")">Gallery</a>
			<a asp-controller="Schedule" asp-action="Index" class="px-nav-link @(currentController == "Schedule" ? "active" : "")">Schedule</a>
			<a asp-controller="Draw"     asp-action="Index" class="px-nav-link @(currentController == "Draw"     ? "active" : "")">Draw</a>
			@{
				var displayState = MatrixClient.Controllers.DisplayController.StateName(PicoStatus.Current);
				var displayLabel = displayState switch { "online" => "Display on", "offline" => "Display off", _ => "Display unknown" };
			}
			<div class="px-display-wrap">
				<button type="button" id="displayStatus" class="px-display px-display-@displayState" data-url="@Url.Action("Status", "Display")"
						title="Checked every minute and after each send; click for the last send" aria-expanded="false" aria-controls="lastSendPanel">
					<span class="px-display-dot"></span><span class="px-display-text">@displayLabel</span>
				</button>
				<div id="lastSendPanel" class="px-lastsend" hidden>
					<div class="px-lastsend-title">Last send</div>
					<div class="px-lastsend-empty">Nothing sent since the app started</div>
					<div class="px-lastsend-body" hidden>
						<img class="px-lastsend-img" alt="Image sent to the matrix" width="96" height="96" />
						<dl class="px-lastsend-info">
							<dt>When</dt><dd data-field="at"></dd>
							<dt>Content</dt><dd data-field="content"></dd>
							<dt>Result</dt><dd data-field="result"></dd>
							<dt>Took</dt><dd data-field="duration"></dd>
						</dl>
					</div>
				</div>
			</div>
		</nav>
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
