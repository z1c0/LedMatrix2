@model Dictionary<string, string[]>

@{
	ViewData["Title"] = "Home Page";
}

<div class="text-center">
	<h1 class="display-4">Pixel Matrix</h1>

	@foreach (var group in Model)
	{
		<h4 class="mt-3 text-capitalize">@group.Key</h4>
		<div class="image-container">
		@foreach (var path in group.Value)
		{
			<img src="@Url.Content("~/data/" + path)" alt="@System.IO.Path.GetFileNameWithoutExtension(path)" class="image-item"
				data-path="@path" onclick="displayLargeImage(this)" />
		}
		</div>
	}

	<div id="large-image-container" class="large-image-container">
		<img id="large-image" src="" alt="Large Image" />
	</div>

	<button id="btnSend" class="btn btn-primary">Send Pixels</button>

</div>

@section scripts {
	<script>
	var selectedPath = null;

	$(document).ready(function () {
		var firstImage = document.querySelector(".image-item");
		if (firstImage) {
			displayLargeImage(firstImage);
		}

		$('#btnSend').click(function () {
			if (!selectedPath) return;
			$.ajax({
				url: '@Url.Action("SendToMatrix", "Pixels")',
				type: 'POST',
				data: { fileName: selectedPath },
				success: function (result) {
					console.log(result);
				},
				error: function (xhr, status, error) {
					console.error(xhr.responseText);
				}
			});
		});
	});

	function displayLargeImage(imgEl) {
		selectedPath = imgEl.dataset.path;
		var largeImage = document.getElementById("large-image");
		largeImage.src = imgEl.src;
		largeImage.style.width = "256px";
		largeImage.style.height = "256px";

		var largeImageContainer = document.getElementById("large-image-container");
		largeImageContainer.style.display = "block";
	}
	</script>
}
