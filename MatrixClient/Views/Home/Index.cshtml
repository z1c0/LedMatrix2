@model IDictionary<string, string[]>

@{
	ViewData["Title"] = "Pixel Matrix";
}

<div class="px-header">
	<h1>Pixel Matrix</h1>
</div>

<div class="px-layout">
	<div class="px-gallery">
		<div class="px-category">dynamic</div>
		<div class="px-grid">
			@foreach (var mode in MatrixClient.Services.DynamicImageService.Modes)
			{
				<img src="@Url.Action("Preview", "Dynamic", new { mode })"
					 alt="@mode" class="px-thumb" data-path="@mode" onclick="selectImage(this)" />
			}
		</div>

		@foreach (var group in Model)
		{
			<div class="px-category">@group.Key</div>
			<div class="px-grid">
			@foreach (var path in group.Value)
			{
				<img src="@Url.Content("~/data/" + path)"
					 alt="@System.IO.Path.GetFileNameWithoutExtension(path)"
					 class="px-thumb"
					 data-path="@path"
					 onclick="selectImage(this)" />
			}
			</div>
		}
	</div>

	<div class="px-sidebar">
		<div class="px-preview">
			<img id="large-image" src="" alt="" />
		</div>
		<button id="btnSend" class="px-send-btn" disabled>Send Pixels</button>
		<div id="sendError" class="px-send-error" style="display:none"></div>
		<div class="px-keys-hint">&larr; &rarr; &uarr; &darr; to browse &middot; Enter to send</div>

		<div class="px-autosend">
			<div class="px-autosend-row">
				<span class="px-autosend-label">Auto-send</span>
				<button id="btnAutoSend" class="px-autosend-toggle">Enable</button>
			</div>
			<div id="autoSendInfo" class="px-autosend-info" style="display:none">
				<span id="activeRuleName"></span> &middot; every <span id="intervalMin"></span> min
				<span id="autoSendPaused" class="px-autosend-paused" style="display:none">&middot; paused while display is off</span>
			</div>
		</div>
	</div>
</div>

@section scripts {
	<script>
	var selectedPath = null;
	var selectedThumb = null;

	$(document).ready(function () {
		var firstImage = document.querySelector(".px-thumb");
		if (firstImage) selectImage(firstImage);

		refreshAutoSendStatus();
		setInterval(refreshAutoSendStatus, 30000);

		document.addEventListener('keydown', onGalleryKey);

		$('#btnAutoSend').click(function () {
			var enabling = $(this).text() === 'Enable';
			$.post(enabling ? '@Url.Action("Enable", "AutoSend")' : '@Url.Action("Disable", "AutoSend")',
				function () { refreshAutoSendStatus(); });
		});

		$('#btnSend').click(function () {
			if (!selectedPath) return;
			var btn = $(this);
			btn.prop('disabled', true).text('Sending…');
			$('#sendError').hide();
			$.ajax({
				url: '@Url.Action("SendToMatrix", "Pixels")',
				type: 'POST',
				data: { fileName: selectedPath },
				success: function (result) {
					if (result.success) {
						btn.text('Sent!');
						setTimeout(function () { btn.prop('disabled', false).text('Send Pixels'); }, 1500);
					} else {
						btn.prop('disabled', false).text('Send Pixels');
						showError(result.error || 'Unknown error');
					}
				},
				error: function (xhr) {
					btn.prop('disabled', false).text('Send Pixels');
					showError((xhr.responseJSON && xhr.responseJSON.error) || 'Request failed');
				},
				// A manual send always tries the matrix, so its outcome is the freshest on/off signal
				complete: function () {
					refreshDisplayStatus();
					refreshAutoSendStatus();
				}
			});
		});
	});

	function refreshAutoSendStatus() {
		$.getJSON('@Url.Action("Status", "AutoSend")', function (s) {
			var btn = $('#btnAutoSend');
			if (s.enabled) {
				btn.text('Disable').addClass('active');
				$('#intervalMin').text(s.intervalMinutes);
				if (s.activeRule) {
					$('#activeRuleName').text(s.activeRule);
					$('#autoSendInfo').show();
				} else {
					$('#activeRuleName').text('no matching rule');
					$('#autoSendInfo').show();
				}
				$('#autoSendPaused').toggle(!!s.displayOffline);
			} else {
				btn.text('Enable').removeClass('active');
				$('#autoSendInfo').hide();
			}
		});
	}

	function showError(msg) {
		$('#sendError').text(msg).show();
	}

	function selectImage(imgEl) {
		if (selectedThumb) selectedThumb.classList.remove('selected');
		selectedThumb = imgEl;
		imgEl.classList.add('selected');
		selectedPath = imgEl.dataset.path;
		document.getElementById('large-image').src = imgEl.src;
		document.getElementById('btnSend').disabled = false;
	}

	// Cursor keys move the selection through the gallery: left/right in reading order across
	// categories, up/down to the nearest thumbnail in the row above/below (measured on screen,
	// so it follows whatever the grid wraps to). Enter sends the selection.
	function onGalleryKey(e) {
		if (e.ctrlKey || e.altKey || e.metaKey) return;
		var tag = (e.target.tagName || '').toLowerCase();
		if (tag === 'input' || tag === 'textarea' || tag === 'select' || e.target.isContentEditable) return;

		var thumbs = Array.prototype.slice.call(document.querySelectorAll('.px-thumb'));
		if (!thumbs.length) return;
		var index = selectedThumb ? thumbs.indexOf(selectedThumb) : -1;
		var next = null;

		switch (e.key) {
			case 'ArrowLeft':  next = thumbs[Math.max(0, index - 1)]; break;
			case 'ArrowRight': next = thumbs[Math.min(thumbs.length - 1, index + 1)]; break;
			case 'ArrowUp':    next = nearestInRow(thumbs, -1); break;
			case 'ArrowDown':  next = nearestInRow(thumbs, 1); break;
			case 'Enter':
				// A focused button handles Enter itself
				if (tag === 'button') return;
				if (!document.getElementById('btnSend').disabled) $('#btnSend').click();
				e.preventDefault();
				return;
			default: return;
		}

		e.preventDefault();   // no page scrolling on arrow keys
		if (next && next !== selectedThumb) {
			selectImage(next);
			next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
		}
	}

	// The thumbnail in the closest row above (direction -1) or below (+1) whose centre is
	// horizontally nearest to the current one
	function nearestInRow(thumbs, direction) {
		if (!selectedThumb) return thumbs[0];
		var cur = selectedThumb.getBoundingClientRect();
		var curX = cur.left + cur.width / 2, curY = cur.top + cur.height / 2;
		var rowY = null, best = null, bestDx = Infinity;

		thumbs.forEach(function (t) {
			var r = t.getBoundingClientRect();
			var y = r.top + r.height / 2;
			if ((y - curY) * direction <= cur.height / 2) return;          // not in that direction
			if (rowY === null || (y - rowY) * direction < -1) {               // a closer row: start over
				rowY = y; best = null; bestDx = Infinity;
			}
			if (Math.abs(y - rowY) <= 1) {
				var dx = Math.abs(r.left + r.width / 2 - curX);
				if (dx < bestDx) { bestDx = dx; best = t; }
			}
		});
		return best;
	}
	</script>
}
